# Copy to .env and adjust. Never commit real credentials.
APP_NAME=Apex Atlas API
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL (psycopg v3 driver)
DATABASE_URL=postgresql+psycopg://apex:apex@localhost:5432/apex_atlas

# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# External data providers (no keys required for these public APIs)
JOLPICA_BASE_URL=https://api.jolpi.ca/ergast/f1
OPENF1_BASE_URL=https://api.openf1.org/v1
HTTP_TIMEOUT_SECONDS=10
